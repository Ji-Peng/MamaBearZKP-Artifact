+/// Build `FriParameters` at one of the three DeepFold-comparison presets.
+/// All three use log_blowup = 3 and binary folding (max_log_arity = 1).
+#[inline]
+fn fri_params_for_security<M>(security: SecurityOptions, mmcs: M) -> FriParameters<M> {
+    match security {
+        SecurityOptions::Conj96 => FriParameters::new_benchmark_conj96(mmcs),
+        SecurityOptions::Prov97 => FriParameters::new_benchmark_prov97(mmcs),
+        SecurityOptions::Prov128 => FriParameters::new_benchmark_prov128(mmcs),
+    }
+}
+
+#[inline]
+fn env_usize(key: &str, default: usize) -> usize {
+    std::env::var(key)
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(default)
+}
+
+/// Run `produce_proof` with `BENCH_WARMUP` un-timed warmups followed by
+/// `BENCH_SAMPLES` timed samples, all inside a single process so caches
+/// and the allocator are genuinely primed across iterations. Returns the
+/// median sample time (ms) and the final proof. Also resets the peak-heap
+/// tracker after warmup so `PLONKY3_PEAK_BYTES` reflects only measured
+/// runs.
+fn bench_prove<T>(mut produce_proof: impl FnMut() -> T) -> (f64, T) {
+    let warmup = env_usize("BENCH_WARMUP", 1);
+    let samples = env_usize("BENCH_SAMPLES", 5).max(1);
+
+    for _ in 0..warmup {
+        let _ = produce_proof();
+    }
+
+    #[cfg(feature = "measure-peak")]
+    crate::PEAK_ALLOC.reset_peak_usage();
+
+    let mut times_ms: Vec<f64> = Vec::with_capacity(samples);
+    let mut last: Option<T> = None;
+    for _ in 0..samples {
+        let t0 = Instant::now();
+        let result = produce_proof();
+        let elapsed_ms = t0.elapsed().as_secs_f64() * 1000.0;
+        times_ms.push(elapsed_ms);
+        last = Some(result);
+    }
+    times_ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let median_ms = times_ms[times_ms.len() / 2];
+    (median_ms, last.expect("samples >= 1"))
+}
