+/// HyperPlonk-style single-gate AIR for a fair DeepFold vs STARK comparison.
+///
+/// Layout: 3 witness columns (L, R, O) and 1 preprocessed column (S).
+/// Constraint `(1 - S)(L + R) + S * L * R - O = 0`, degree 3, one row per
+/// gate, no transition constraints, no lookups. Matches the HyperPlonk
+/// algebraic gate `h(X) = (1-S)(L+R) + S*L*R - O` at the same trace height.
+///
+/// The selector column S is sampled as a deterministic random boolean
+/// sequence (seed 2); the witness generator uses seed 3 for L, R, and
+/// derives O to satisfy the constraint by construction.
+pub struct HyperPlonkGateAir<F> {
+    pub num_rows: usize,
+    s_values: Vec<F>,
+}
+
+impl<F: PrimeCharacteristicRing> HyperPlonkGateAir<F> {
+    pub fn new(num_rows: usize) -> Self {
+        let mut rng = SmallRng::seed_from_u64(2);
+        let s_values: Vec<F> = (0..num_rows)
+            .map(|_| {
+                if rng.random::<bool>() {
+                    F::ONE
+                } else {
+                    F::ZERO
+                }
+            })
+            .collect();
+        Self { num_rows, s_values }
+    }
+}
+
+impl<F> BaseAir<F> for HyperPlonkGateAir<F>
+where
+    F: PrimeCharacteristicRing + Send + Sync,
+{
+    fn width(&self) -> usize {
+        3
+    }
+
+    fn preprocessed_trace(&self) -> Option<RowMajorMatrix<F>> {
+        Some(RowMajorMatrix::new(self.s_values.clone(), 1))
+    }
+
+    fn main_next_row_columns(&self) -> Vec<usize> {
+        vec![]
+    }
+
+    fn preprocessed_next_row_columns(&self) -> Vec<usize> {
+        vec![]
+    }
+
+    fn max_constraint_degree(&self) -> Option<usize> {
+        Some(3)
+    }
+}
+
+impl<AB: AirBuilder> Air<AB> for HyperPlonkGateAir<AB::F>
+where
+    AB::F: PrimeCharacteristicRing + Send + Sync,
+{
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let main_row = main.current_slice();
+        let l_var = main_row[0];
+        let r_var = main_row[1];
+        let o_var = main_row[2];
+
+        let s_var = {
+            let prep = builder.preprocessed();
+            let prep_row = prep.current_slice();
+            prep_row[0]
+        };
+
+        let one = AB::Expr::ONE;
+        let l: AB::Expr = l_var.into();
+        let r: AB::Expr = r_var.into();
+        let o: AB::Expr = o_var.into();
+        let s: AB::Expr = s_var.into();
+
+        let add_part = (one - s.clone()) * (l.clone() + r.clone());
+        let mul_part = s * l * r;
+        builder.assert_zero(add_part + mul_part - o);
+        builder.assert_bool(s_var);
+    }
+}
+
+impl<
+    F: PrimeField64,
+    Domain: PolynomialSpace<Val = F>,
+    EF: ExtensionField<F>,
+    Challenger: FieldChallenger<F>,
+    Pcs: p3_commit::Pcs<EF, Challenger, Domain = Domain>,
+    SC: StarkGenericConfig<Pcs = Pcs, Challenge = EF, Challenger = Challenger>,
+> ExampleHashAir<F, SC> for HyperPlonkGateAir<F>
+{
+    #[inline]
+    fn generate_trace_rows(
+        &self,
+        num_hashes: usize,
+        _extra_capacity_bits: usize,
+    ) -> RowMajorMatrix<F>
+    where
+        StandardUniform: Distribution<F>,
+    {
+        assert_eq!(
+            num_hashes, self.num_rows,
+            "HyperPlonkGateAir: trace row count must match self.num_rows"
+        );
+        let width: usize = 3;
+        let mut values: Vec<F> = F::zero_vec(num_hashes * width);
+        let mut rng = SmallRng::seed_from_u64(3);
+        for i in 0..num_hashes {
+            let l: F = rng.sample(StandardUniform);
+            let r: F = rng.sample(StandardUniform);
+            let s = self.s_values[i].clone();
+            // o = (1 - s) * (l + r) + s * l * r
+            let one_minus_s = F::ONE - s.clone();
+            let o = one_minus_s * (l.clone() + r.clone()) + s * l.clone() * r.clone();
+            values[i * width] = l;
+            values[i * width + 1] = r;
+            values[i * width + 2] = o;
+        }
+        RowMajorMatrix::new(values, width)
+    }
+}
 
