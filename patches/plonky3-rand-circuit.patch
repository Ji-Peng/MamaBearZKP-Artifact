+/// Run `do_verify` with `BENCH_WARMUP` un-timed warmups followed by
+/// `BENCH_SAMPLES` timed samples; return median sample time (ms) and
+/// assert every sample returned the same Ok/Err status. Resets the
+/// peak-heap tracker after warmup so `PLONKY3_VERIFY_PEAK_BYTES` reflects
+/// only measured verify runs.
+fn bench_verify<E: core::fmt::Debug>(
+    mut do_verify: impl FnMut() -> Result<(), E>,
+) -> (f64, Result<(), E>) {
+    let warmup = env_usize("BENCH_WARMUP", 1);
+    let samples = env_usize("BENCH_SAMPLES", 5).max(1);
+
+    for _ in 0..warmup {
+        let _ = do_verify();
+    }
+
+    #[cfg(feature = "measure-peak")]
+    crate::PEAK_ALLOC.reset_peak_usage();
+
+    let mut times_ms: Vec<f64> = Vec::with_capacity(samples);
+    let mut last: Option<Result<(), E>> = None;
+    for _ in 0..samples {
+        let t0 = Instant::now();
+        let result = do_verify();
+        let elapsed_ms = t0.elapsed().as_secs_f64() * 1000.0;
+        times_ms.push(elapsed_ms);
+        last = Some(result);
+    }
+    times_ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let median_ms = times_ms[times_ms.len() / 2];
+    (median_ms, last.expect("samples >= 1"))
+}
